# User-session unit; install under ~/.config/systemd/user/.
[Unit]
Description=Remote driving desktop instance %i
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=exec
EnvironmentFile=%h/.config/remote-driving/%i.env
Environment=RD_RUNTIME_DIR=%h/.local/state/remote-driving/%i
ExecStart=/usr/bin/python3 /usr/local/lib/remote-driving/manage_release.py run --root %h/.local/share/remote-driving/%i
Restart=no
KillMode=mixed
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical-session.target
