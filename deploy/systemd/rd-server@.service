[Unit]
Description=Remote driving server instance %i
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
User=rd-server
Group=rd-server
EnvironmentFile=/etc/remote-driving/%i.env
Environment=RD_RUNTIME_DIR=/var/lib/remote-driving/%i
StateDirectory=remote-driving/%i
WorkingDirectory=/var/lib/remote-driving/%i
ExecStart=/usr/bin/python3.12 /usr/local/lib/remote-driving/manage_release.py run --root /opt/remote-driving/%i
Restart=on-failure
RestartSec=3
KillMode=mixed
TimeoutStopSec=20
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
